# =======================================================
# Velora Circle Backend - Environment Variables Template
# Set these variables in the Render Dashboard (Environment tab)
# =======================================================

# Port assigned by Render (automatically injected by Render in production)
PORT=4000

# MongoDB Atlas connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/Veloracircle?retryWrites=true&w=majority

# Secret key used for JWT signing and verification
JWT_SECRET=your_jwt_secret_change_in_production

# Secret key used for internal inter-service authentication
INTERNAL_SERVICE_SECRET=your_internal_service_secret_2026

# 32-byte (64 hex characters) key used for AES-256 message encryption
MESSAGE_ENCRYPTION_KEY=83152c9ac9aa3d0924b159b985d2d1ab63227fc0646d3796f72b904786b1f03d

# SMTP / Email service configuration (for Auth OTP and meeting notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="Velora Circle <your_email@gmail.com>"
