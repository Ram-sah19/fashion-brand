# ========================================================
# Velora Circle Frontend - Environment Variables
# Set these in Cloudflare Pages Dashboard -> Settings -> Environment variables
# ========================================================

# Render backend service URL (used for WebSockets and direct API fallback)
VITE_API_URL=https://velora-circle-backend.onrender.com

# Optional explicit Socket.IO URL (defaults to VITE_API_URL if omitted)
# VITE_SOCKET_URL=https://velora-circle-backend.onrender.com

# Build preset for Nitro (defaults to cloudflare-pages in vite.config.ts)
NITRO_PRESET=cloudflare-pages
